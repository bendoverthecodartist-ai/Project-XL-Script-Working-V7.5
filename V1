task.spawn(function()
    local lastAbilityFired = 0
    local lastQuestFired = 0
    local lastAttackFired = 0
    
    while scriptRunning do
        local currentTime = os.clock()
        local character = Player.Character
        local myHrp = character and character:FindFirstChild("HumanoidRootPart")

        -- Movement Logic: Priority goes to Auto-Tween, then Quest Lock
        if myHrp then
            if autoTweenToEnemy then
                local targetEnemyHrp = getClosestEnemy()
                if targetEnemyHrp then
                    -- Positioned slightly above the target to avoid clipping ground geometry
                    myHrp.CFrame = targetEnemyHrp.CFrame * CFrame.new(0, 2, 0)
                    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            elseif autoDefeatDemonsQuest then
                myHrp.CFrame = CFrame.new(lockPosition)
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end

        -- Handle Quest Remote Interval
        if autoDefeatDemonsQuest and (currentTime - lastQuestFired >= 7.5) then
            local questFolder = game:GetService("ReplicatedStorage"):WaitForChild("Quests", 3)
            local targetQuest = questFolder and questFolder:FindFirstChild("Defeat 4 Demons")
            if targetQuest then
                ChangeQuestRemote:FireServer(targetQuest)
            end
            lastQuestFired = currentTime
        end

        -- Combat loops
        if autoAttack and (currentTime - lastAttackFired >= 0.2) then
            BladeCombatRemote:FireServer()
            lastAttackFired = currentTime
        end

        if autoFlamingBreakdance and (currentTime - lastAbilityFired >= flamingBreakdanceTimer) then
            local args = {
                false,
                Vector3.new(13940.423828125, -4525.97314453125, -2880.3310546875),
                CFrame.new(13940.423828125, -4525.97314453125, -2880.3310546875, 0.5124840140342712, 0.4154948592185974, -0.7514813542366028, 1.4901159417490817e-08, 0.8751417398452759, 0.483866810798645, 0.8586967587471008, -0.24797402322292328, 0.44849616289138794),
                1
            }
            FlamingBreakdanceRemote:FireServer(unpack(args))
            lastAbilityFired = currentTime
        end

        if autoRebirth then
            RebirthRemote:FireServer()
        end
        
        task.wait() 
    end
end)

-- Helper function to find the closest enemy within workspace.Live folders
local function getClosestEnemy()
    local closestEnemy = nil
    local shortestDistance = math.huge
    local character = Player.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    
    local liveFolder = workspace:FindFirstChild("Live")
    if not myHrp or not liveFolder then return nil end

    -- Loop through each folder inside workspace.Live
    for _, enemyFolder in ipairs(liveFolder:GetChildren()) do
        -- Find the actual character model inside the folder
        for _, obj in ipairs(enemyFolder:GetChildren()) do
            if obj:IsA("Model") and obj ~= character then
                local enemyHrp = obj:FindFirstChild("HumanoidRootPart")
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                
                -- Check if enemy is alive and has a root part
                if enemyHrp and humanoid and humanoid.Health > 0 then
                    local distance = (myHrp.Position - enemyHrp.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestEnemy = enemyHrp
                    end
                end
            end
        end
    end
    return closestEnemy
end


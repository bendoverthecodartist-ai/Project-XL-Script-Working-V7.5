-- Insanely fast master loop for buying (Runs every frame)
task.spawn(function()
    while scriptRunning do
        if autoBuyArmor then
            local args = { "Random Armor" }
            BuyItemRemote:FireServer(unpack(args))
        end

        if autoBuyAccessory then
            local args = { "Random Accessory" }
            BuyItemRemote:FireServer(unpack(args))
        end

        if autoBuySpecialization then
            local args = { "Random Specialization" }
            BuyItemRemote:FireServer(unpack(args))
        end

        if autoBuyArrow then
            local args = { "Arrow" }
            BuyItemRemote:FireServer(unpack(args))
        end

        task.wait() 
    end
end)

-- Dedicated loop for handling timed actions, combat, and position locks
task.spawn(function()
    local lastAbilityFired = 0
    local lastQuestFired = 0
    local lastAttackFired = 0
    
    while scriptRunning do
        local currentTime = os.clock()

        -- Force position lock smoothly every frame IF the quest toggle is enabled
        if autoDefeatDemonsQuest then
            local character = Player.Character
            if character then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(lockPosition)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
            end

            -- Handle the Auto Quest remote refresh interval (7.5s)
            if currentTime - lastQuestFired >= 7.5 then
                local questFolder = game:GetService("ReplicatedStorage"):WaitForChild("Quests", 3)
                local targetQuest = questFolder and questFolder:FindFirstChild("Defeat 4 Demons")
                
                if targetQuest then
                    local args = { targetQuest }
                    ChangeQuestRemote:FireServer(unpack(args))
                end
                lastQuestFired = currentTime
            end
        end

        -- Working Auto Attack loop using BladeCombatRemote
        if autoAttack then
            if currentTime - lastAttackFired >= 0.2 then
                BladeCombatRemote:FireServer()
                lastAttackFired = currentTime
            end
        end

        -- Handle direct remote firing for Flaming Breakdance
        if autoFlamingBreakdance then
            if currentTime - lastAbilityFired >= flamingBreakdanceTimer then
                local args = {
                    false,
                    Vector3.new(13940.423828125, -4525.97314453125, -2880.3310546875),
                    CFrame.new(13940.423828125, -4525.97314453125, -2880.3310546875, 0.5124840140342712, 0.4154948592185974, -0.7514813542366028, 1.4901159417490817e-08, 0.8751417398452759, 0.483866810798645, 0.8586967587471008, -0.24797402322292328, 0.44849616289138794),
                    1
                }
                FlamingBreakdanceRemote:FireServer(unpack(args))
                lastAbilityFired = currentTime
            end
        end

        -- Handle direct remote firing for Auto Rebirth
        if autoRebirth then
            RebirthRemote:FireServer()
        end
        
        task.wait() 
    end
end)
